# Zoom Server-to-Server OAuth app credentials (Zoom App Marketplace -> Build App -> Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=

# Where the "already processed" meeting log is stored.
#   file (default) - no setup needed. Attach a Railway volume at STATE_PATH
#     if you want it to survive redeploys; otherwise it's ephemeral (fine -
#     worst case a meeting or two gets reprocessed after a redeploy).
#   supabase - point at your own Supabase project instead.
STATE_BACKEND=file
# STATE_PATH=/data/processed_meetings.json
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_TABLE=zoom_processed_meetings

# Shared secret this deployment requires on every request once running
# remotely. Generate your own random value.
MCP_AUTH_TOKEN=

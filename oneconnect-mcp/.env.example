# OneConnect.pro -- Settings -> API Tokens -- generate a token scoped to
# at least: accounts:read, prospects:read, tasks:read, meetings:read,
# clients:read (write scopes don't exist on the API yet as of this
# writing -- read-only is all there is).
ONECONNECT_TOKEN=
ONECONNECT_API_BASE=https://oneconnect.pro/api

# Your OneConnect office/tenant slug (e.g. "oneindiana"). Check your
# OneConnect.pro URL or ask your admin -- do NOT guess or leave blank,
# the server refuses to start without it.
ONECONNECT_TENANT_SLUG=

# Shared secret this deployment requires on every request once running
# remotely. Generate your own random value.
MCP_AUTH_TOKEN=

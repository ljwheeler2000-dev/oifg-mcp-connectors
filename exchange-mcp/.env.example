# EWS / Smarsh-hosted Exchange credentials
EWS_SERVER=mail.smarshmail.com
EWS_EMAIL=your.email@yourfirm.com
EWS_USERNAME=your.email@yourfirm.com
EWS_PASSWORD=your-exchange-password
EWS_TIMEZONE=America/Indiana/Indianapolis

# Shared secret this deployment requires on every request once running
# remotely (Streamable HTTP). Generate your own — never reuse someone
# else's value. Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
